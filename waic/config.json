{
  "stylesheets": [
    "https://www.w3.org/WAI/assets/css/style.css",
    "https://www.w3.org/WAI/content-assets/wai-aria-practices/styles.css",
    "https://www.w3.org/WAI/content-assets/wai-aria-practices/shared/css/github.css",
    "{{BASE}}shared/css/apg-overrides.css"
  ],
  "removeStylesheets": [
    "StyleSheets/TR/2016/base.css",
    "shared/css/core.css"
  ],
  "tabs": [
    { "key": "home",      "label": "ホーム",         "href": "" },
    { "key": "patterns",  "label": "パターン",       "href": "patterns/" },
    { "key": "practices", "label": "実践",           "href": "practices/" },
    { "key": "index",     "label": "インデックス",   "href": "example-index/" },
    { "key": "about",     "label": "概要",           "href": "about/" }
  ],
  "notices": {
    "full":  "ja-status-notice-full.html",
    "short": "ja-status-notice-short.html"
  },
  "transform": {
    "apg-home.html":            { "homeLayout": true,
                                  "publishAs": "index.html",
                                  "notice": "full",
                                  "extraStylesheets": ["https://www.w3.org/WAI/content-assets/wai-aria-practices/homepage.css"] },
    "patterns/patterns.html":   { "publishAs": "patterns/index.html", "notice": "short" },
    "practices/practices.html": { "publishAs": "practices/index.html", "notice": "short" },
    "about/about.html":         { "publishAs": "about/index.html", "notice": "short" },
    "index/index.html":         { "publishAs": "example-index/index.html" },
    "patterns/landmarks/examples/**": null,
    "patterns/feed/examples/feed-display.html": null,
    "patterns/toolbar/examples/help.html": null,
    "patterns/**":              { "toc": true },
    "practices/**":             { "toc": true },
    "about/**":                 { "toc": true }
  }
}
